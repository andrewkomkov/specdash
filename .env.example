# Folder that contains your spec-kit projects. Mounted read-only into the container.
# Point it at the parent directory you keep repositories in, e.g. ~/projects.
PROJECTS_ROOT=/absolute/path/to/your/projects

# Where the dashboard is served on the host.
# The board has no authentication. Bound to localhost unless you say otherwise.
#SPECDASH_BIND=127.0.0.1

SPECDASH_PORT=8420

# How deep under PROJECTS_ROOT to search for projects (a project = .specify/ or specs/).
SPECDASH_MAX_DEPTH=2

# File watching. Docker bind mounts on macOS/Windows need polling; on Linux you
# can set this to 0 to use native inotify events instead.
SPECDASH_POLLING=1
SPECDASH_POLL_DELAY_MS=800

TZ=Europe/Berlin
